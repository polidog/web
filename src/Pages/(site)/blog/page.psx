<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\PageCache;
use App\View\Components;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * `/blog/` — Hugo の section list ページ。
 *
 * 記事本体の URL は `/YYYY/MM/DD/slug/` に飛ばされていた（permalinks.toml）
 * が、セクションの一覧ページはこの URL で公開されていたので、そのまま残す。
 * 中身はトップと同じ「新しい順の全記事」。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta): Closure {
    $ctx->cache(PageCache::list());
    $meta->apply('/blog', 'Blogs', 'これまでに書いた記事の一覧。');

    return function () use ($posts): Element {
        $list = $posts->listPublished(1);

        return (
            <div>
                {Components::heading('Blogs', \sprintf('全 %d 件', $list->total))}
                {Components::postList($list->items)}
                {Components::pagination($list->page, $list->pages(), '/blog')}
            </div>
        );
    };
};
