<?php

declare(strict_types=1);

namespace App\Layouts;

use App\Support\SiteConfig;
use Polidog\Relayer\Router\Layout\LayoutComponent;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 公開側の外殻。Hugo テーマ（website/themes/polidog）のヘッダ・フッタを
 * 移植したもので、Tailwind のクラスもそのまま引き継いでいる。
 *
 * ダークモードの切り替えとモバイルメニューの開閉は /assets/site.js。
 * 初期テーマの反映だけは描画前に走らせる必要があるので、SiteDocument が
 * head にインラインで置いている。
 */
final class RootLayout extends LayoutComponent
{
    /** @var list<array{href: string, label: string}> */
    private const array NAVIGATION = [
        ['href' => '/archives', 'label' => 'Archives'],
        ['href' => '/tech-tags', 'label' => 'Tags'],
        ['href' => '/about', 'label' => 'About'],
    ];

    public function __construct(private readonly SiteConfig $site) {}

    public function render(): Element
    {
        return (
            <div className="w-full">
                <header className="relative">
                    <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                        {$this->headerBar()}
                        {$this->mobileMenu()}
                    </div>
                </header>
                <main>
                    <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
                        {$this->getChildren()}
                    </div>
                </main>
                <footer className="border-t border-gray-200 dark:border-gray-800 mt-16">
                    <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
                        <div className="flex flex-col items-center justify-between gap-6 sm:flex-row">
                            <div className="flex gap-6 text-sm font-medium text-gray-800 dark:text-gray-200">
                                <a href="/about" className="hover:text-gray-900 dark:hover:text-white">About</a>
                                <a href="/tech-tags" className="hover:text-gray-900 dark:hover:text-white">Tags</a>
                                <a href="/index.xml" className="hover:text-gray-900 dark:hover:text-white">RSS</a>
                            </div>
                            <p className="text-sm text-gray-500 dark:text-gray-400">
                                {\sprintf('Copyright © %s %s. All rights reserved.', \date('Y'), $this->site->title)}
                            </p>
                        </div>
                    </div>
                </footer>
            </div>
        );
    }

    private function headerBar(): Element
    {
        return (
            <div className="flex items-center justify-between py-6">
                <a href="/" className="text-2xl font-bold text-gray-900 dark:text-white">{$this->site->title}</a>
                <div className="ml-auto flex items-center gap-6">
                    <nav className="hidden md:block">
                        <ul className="flex items-center gap-8">
                            {\array_map(self::navLink(...), self::NAVIGATION)}
                        </ul>
                    </nav>
                    <div className="hidden md:block h-5 w-px bg-gray-300 dark:bg-gray-700"></div>
                    <div className="flex gap-4 items-center">
                        <button
                            id="theme-toggle"
                            type="button"
                            className="text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                            aria-label="ダークモード切替"
                        >
                            <span className="hidden dark:inline">☀</span>
                            <span className="inline dark:hidden">☾</span>
                        </button>
                        <a
                            href={\sprintf('https://github.com/%s', $this->site->author)}
                            className="text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                            target="_blank"
                            rel="noopener"
                        >GitHub</a>
                    </div>
                    <button
                        id="mobile-menu-button"
                        type="button"
                        className="md:hidden rounded-md p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                        aria-label="メニュー"
                    >☰</button>
                </div>
            </div>
        );
    }

    private function mobileMenu(): Element
    {
        return (
            <div id="mobile-menu" className="md:hidden hidden">
                <div className="space-y-1 px-2 pb-3 pt-2">
                    {\array_map(self::mobileLink(...), self::NAVIGATION)}
                </div>
            </div>
        );
    }

    /**
     * @param array{href: string, label: string} $item
     */
    private static function navLink(array $item): Element
    {
        return (
            <li>
                <a
                    href={$item['href']}
                    className="text-sm font-medium text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                >{$item['label']}</a>
            </li>
        );
    }

    /**
     * @param array{href: string, label: string} $item
     */
    private static function mobileLink(array $item): Element
    {
        return (
            <a
                href={$item['href']}
                className="block rounded-md px-3 py-2 text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
            >{$item['label']}</a>
        );
    }
}
