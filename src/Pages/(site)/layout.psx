<?php

declare(strict_types=1);

namespace App\Layouts;

use App\Support\SiteConfig;
use Polidog\Relayer\Router\Layout\LayoutComponent;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 公開側の外殻。
 *
 * 罫線を持たない。ヘッダ・本文・フッタの区切りは余白と文字の濃さだけで
 * 付ける（`Components` 側も同じ方針で、`border-*` はほぼ出てこない）。
 * 幅は `max-w-measure`（44rem）で、外殻・一覧・記事本文すべて同じ measure に
 * 揃えてある——読み物として 1 本の柱に見せたいので、ページごとに幅を
 * 変えない。
 *
 * 等幅（`font-mono`）はサイト名・日付・年号・ページ番号にだけ使う。
 * 「識別子と時間は等幅」という 1 本の規則にしてあるので、それ以外の語には
 * 使わないこと。
 *
 * 色は `assets/tailwind.css` の CSS 変数で切り替わるので `dark:` は書かない
 * （テーマトグルのアイコン差し替えだけは色ではなく表示の切り替えなので
 * `dark:inline` / `dark:hidden` を使っている——例外はここだけ）。
 *
 * ダークモードの切り替えとモバイルメニューの開閉は /assets/site.js。
 * 初期テーマの反映だけは描画前に走らせる必要があるので、SiteDocument が
 * head にインラインで置いている。
 */
final class RootLayout extends LayoutComponent
{
    /** @var list<array{href: string, label: string}> */
    private const array NAVIGATION = [
        ['href' => '/archives', 'label' => 'Archives'],
        ['href' => '/tech-tags', 'label' => 'Tags'],
        ['href' => '/about', 'label' => 'About'],
    ];

    public function __construct(private readonly SiteConfig $site) {}

    public function render(): Element
    {
        return (
            <div className="flex min-h-full w-full flex-col">
                <header>
                    <div className="mx-auto w-full max-w-measure px-5">
                        {$this->headerBar()}
                        {$this->mobileMenu()}
                    </div>
                </header>
                <main className="flex-1">
                    <div className="mx-auto w-full max-w-measure px-5 pb-28 pt-6">
                        {$this->getChildren()}
                    </div>
                </main>
                {$this->footer()}
            </div>
        );
    }

    private function headerBar(): Element
    {
        return (
            <div className="flex items-baseline justify-between py-10">
                <a
                    href="/"
                    className="font-mono text-[0.9375rem] tracking-[0.14em] text-ink transition-colors hover:text-accent"
                >{$this->site->title}</a>

                {$this->desktopNav()}

                <div className="flex items-baseline gap-5 md:hidden">
                    {$this->themeToggle()}
                    <button
                        id="mobile-menu-button"
                        type="button"
                        className="text-lg leading-none text-muted transition-colors hover:text-ink"
                        aria-label="メニューを開く"
                        aria-controls="mobile-menu"
                        aria-expanded="false"
                    >☰</button>
                </div>
            </div>
        );
    }

    /**
     * ナビの children は先に 1 本の配列に均しておく。usePHP が平坦化するのは
     * 「子が配列 1 つだけ」のときで、配列と要素を並べるとネストした配列が
     * そのまま渡り、レンダラが Element|string|null を期待して落ちる。
     */
    private function desktopNav(): Element
    {
        $items = \array_map(self::navLink(...), self::NAVIGATION);
        $items[] = H::a(
            href: \sprintf('https://github.com/%s', $this->site->author),
            className: 'text-[0.8125rem] text-muted transition-colors hover:text-ink',
            target: '_blank',
            rel: 'noopener',
            children: 'GitHub',
        );
        $items[] = $this->themeToggle();

        return H::nav(className: 'hidden items-baseline gap-7 md:flex', children: $items);
    }

    private function themeToggle(): Element
    {
        return (
            <button
                id="theme-toggle"
                type="button"
                className="text-sm leading-none text-muted transition-colors hover:text-ink"
                aria-label="表示テーマを切り替える"
            >
                <span className="hidden dark:inline">☀</span>
                <span className="inline dark:hidden">☾</span>
            </button>
        );
    }

    private function mobileMenu(): Element
    {
        return (
            <div id="mobile-menu" className="hidden pb-6 md:hidden">
                <div className="flex flex-col gap-4">
                    {\array_map(self::mobileLink(...), self::NAVIGATION)}
                </div>
            </div>
        );
    }

    private function footer(): Element
    {
        return (
            <footer>
                <div className="mx-auto w-full max-w-measure px-5 pb-16">
                    <div className="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
                        <nav className="flex gap-6 text-[0.8125rem] text-muted">
                            <a href="/about" className="transition-colors hover:text-ink">About</a>
                            <a href="/tech-tags" className="transition-colors hover:text-ink">Tags</a>
                            <a href="/index.xml" className="transition-colors hover:text-ink">RSS</a>
                        </nav>
                        <p className="font-mono text-xs tracking-wide text-muted">
                            {\sprintf('© %s %s', \date('Y'), $this->site->title)}
                        </p>
                    </div>
                </div>
            </footer>
        );
    }

    /**
     * @param array{href: string, label: string} $item
     */
    private static function navLink(array $item): Element
    {
        return (
            <a
                href={$item['href']}
                className="text-[0.8125rem] text-muted transition-colors hover:text-ink"
            >{$item['label']}</a>
        );
    }

    /**
     * @param array{href: string, label: string} $item
     */
    private static function mobileLink(array $item): Element
    {
        return (
            <a
                href={$item['href']}
                className="text-base text-muted transition-colors hover:text-ink"
            >{$item['label']}</a>
        );
    }
}
