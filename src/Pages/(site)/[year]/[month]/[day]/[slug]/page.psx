<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\HtmlToElement;
use App\Support\PageCache;
use App\Support\SiteConfig;
use App\View\Components;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 記事詳細。
 *
 * URL の形は Hugo の `config/_default/permalinks.toml` が決めていた:
 *
 *     blog = "/:year/:month/:day/:filename/"
 *
 * つまり `content/blog/2024/12/look-back-on-year.md` は
 * `/blog/2024/12/...` ではなく **`/2024/12/28/look-back-on-year/`**
 * （日付は front matter の date、最後はファイル名）で公開されている。
 * ディレクトリ構造は URL に出てこない。
 *
 * 全セグメントが動的だが、`/tags/[slug]/page/[n]` のような静的セグメントを
 * 持つルートには必ず負ける（ルーターは静的セグメントの多い順に照合する）
 * ので、タグやカテゴリの URL を食うことはない。
 *
 * 動的セグメントの値は URL エンコードされたまま渡ってくる。日本語
 * スラッグの記事が大量にあるので `rawurldecode()` を通す。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta, SiteConfig $site): Closure {
    $path = \sprintf(
        '/%s/%s/%s/%s',
        \rawurldecode((string) ($ctx->params['year'] ?? '')),
        \rawurldecode((string) ($ctx->params['month'] ?? '')),
        \rawurldecode((string) ($ctx->params['day'] ?? '')),
        \rawurldecode((string) ($ctx->params['slug'] ?? '')),
    );

    // ETag はこの URL 専用。記事を保存したときだけ PostWriter が差し替える。
    $ctx->cache(PageCache::post($path));

    return function () use ($ctx, $posts, $meta, $site, $path): Element {
        $post = $posts->findPublishedByPath($path, 'post') ?? $ctx->notFound();

        $id = (int) $post['id'];
        $tags = $posts->tagsOf($id);
        $categories = $posts->categoriesOf($id);
        $neighbours = $posts->neighbours((string) $post['publishedAt'], $id);

        $meta->apply(
            path: $path,
            title: (string) $post['title'],
            description: (string) ($post['excerpt'] ?? ''),
            ogType: 'article',
            image: null !== $post['eyecatch'] ? (string) $post['eyecatch'] : null,
        );

        return (
            <article>
                <header>
                    {Components::date((string) $post['publishedAt'])}
                    <h1 className="mt-3 text-[1.875rem] font-semibold leading-tight tracking-tight text-ink sm:text-[2.25rem]">
                        {(string) $post['title']}
                    </h1>
                    {[] !== $tags
                        ? <div className="mt-5">{Components::termBadges($tags, '/tags')}</div>
                        : null}
                    {null !== $post['eyecatch']
                        ? <div className="mt-10 overflow-hidden rounded bg-raised">
                            <img
                                className="h-auto max-w-full object-cover"
                                src={(string) $post['eyecatch']}
                                alt={(string) $post['title']}
                            />
                        </div>
                        : null}
                </header>

                <div className="prose mt-12">
                    {HtmlToElement::convert((string) $post['html'])}
                </div>

                {[] !== $categories
                    ? <div className="mt-16">
                        <h2 className="text-xs text-muted">カテゴリ</h2>
                        <div className="mt-2">{Components::termBadges($categories, '/categories')}</div>
                    </div>
                    : null}

                <div className="mt-16">
                    <a
                        href={\sprintf(
                            'https://twitter.com/intent/tweet?url=%s&text=%s',
                            \rawurlencode($site->absoluteUrl($path)),
                            \rawurlencode((string) $post['title']),
                        )}
                        className="text-[0.8125rem] text-muted transition-colors hover:text-accent"
                        target="_blank"
                        rel="noopener noreferrer"
                    >この記事を X で共有 →</a>
                </div>

                {Components::neighbourNav($neighbours)}
                {Components::disqus($site, $path, (string) ($post['disqusId'] ?? ''), (string) $post['title'])}
            </article>
        );
    };
};
