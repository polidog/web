<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\PageCache;
use App\View\Components;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 月別アーカイブ（Hugo の `content/archives/_index.md` + `archives/list.html`）。
 *
 * 全記事を新しい順に並べ、月の見出しで束ねて 30 件ずつページングする
 * （一覧系の既定 25 件ではない — Hugo がここだけ 30 だった）。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta): Closure {
    $ctx->cache(PageCache::list());
    $meta->apply('/archives', '月別アーカイブ', '2004 年からの記事を月別にまとめたもの。');

    return function () use ($posts): Element {
        $list = $posts->archive(1);

        return (
            <div>
                {Components::heading('月別アーカイブ', \sprintf('全 %d 件', $list->total))}
                {Components::archiveList($list->items)}
                {Components::pagination($list->page, $list->pages(), '/archives')}
            </div>
        );
    };
};
