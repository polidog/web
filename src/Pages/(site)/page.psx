<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\PageCache;
use App\Support\SiteConfig;
use App\View\Components;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * トップページ。Hugo の home.html 相当で、最新 25 件を出す。
 *
 * 外側の factory ではキャッシュ宣言と meta の設定しかしない。DB を引くのは
 * 内側の render closure で、そこは 304 で短絡されたときには走らない。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta, SiteConfig $site): Closure {
    $ctx->cache(PageCache::home());
    $meta->apply('/', '', $site->description, image: '/assets/ogp/top.webp');

    return function () use ($posts): Element {
        $list = $posts->listPublished(1);

        return (
            <div>
                {Components::heading('最近の記事')}
                {Components::postList($list->items)}
                {Components::pagination($list->page, $list->pages())}
            </div>
        );
    };
};
