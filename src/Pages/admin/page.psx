<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 管理画面のダッシュボード。件数と、直近に触った記事だけを出す。
 *
 * 件数は囲わずに数字だけを大きく置く。公開側の年号マーカーと同じ考え方で、
 * 数は等幅で組めばそれ自体が目印になるので、カードの罫線は要らない。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta): Closure {
    $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin', 'ダッシュボード');

    return function () use ($posts): Element {
        $counts = $posts->counts();
        $recent = $posts->listForAdmin('post', 1, perPage: 10);

        $stat = static fn (string $label, int $value, string $href): Element => (
            <a href={$href} className="group flex flex-col gap-1">
                <span className="font-mono text-4xl font-light leading-none tracking-tight text-faint transition-colors group-hover:text-accent">
                    {(string) $value}
                </span>
                <span className="text-xs text-muted">{$label}</span>
            </a>
        );

        return (
            <div className="flex flex-col gap-12">
                <div className="flex flex-wrap gap-x-16 gap-y-8">
                    {$stat('公開中の記事', $counts['posts'], '/admin/posts?status=published')}
                    {$stat('下書き', $counts['drafts'], '/admin/posts?status=draft')}
                    {$stat('固定ページ', $counts['pages'], '/admin/pages')}
                </div>

                <section>
                    <div className="mb-4 flex items-baseline justify-between gap-4">
                        <h2 className="text-xs tracking-wide text-faint">最近の記事</h2>
                        <a
                            href="/admin/posts/new"
                            className={AdminComponents::BUTTON}
                        >新しい記事</a>
                    </div>
                    {AdminComponents::postTable($recent, '/admin/posts')}
                </section>
            </div>
        );
    };
};
