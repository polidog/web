<?php

declare(strict_types=1);

use App\Auth\GithubOAuth;
use App\Service\PageMeta;
use App\Support\PageCache;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * ログイン画面。フォームは無く、GitHub へ飛ばすリンクが 1 本あるだけ。
 * state の発行は `/admin/auth/github` 側で行う（GET のたびに state を
 * 作り直すと、開いたまま放置したタブからログインできなくなるため）。
 */
return function (PageContext $ctx, PageMeta $meta, GithubOAuth $oauth, Request $request): Closure {
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/login', 'ログイン');

    $failed = null !== $request->query('error');
    $configured = $oauth->configured();

    return function () use ($failed, $configured): Element {
        return (
            <div className="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-slate-800">
                <h1 className="text-xl font-bold text-gray-900 dark:text-white">管理画面にログイン</h1>

                {$failed
                    ? <p className="mt-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">
                        ログインできませんでした。許可されたアカウントか確認してください。
                    </p>
                    : null}

                {$configured
                    ? <a
                        href="/admin/auth/github"
                        className="mt-6 inline-flex w-full items-center justify-center rounded-md bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
                    >GitHub でログイン</a>
                    : <p className="mt-6 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                        GITHUB_CLIENT_ID と GITHUB_CLIENT_SECRET が設定されていません。
                    </p>}
            </div>
        );
    };
};
