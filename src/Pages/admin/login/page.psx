<?php

declare(strict_types=1);

use App\Auth\AdminUserProvider;
use App\Auth\Oauth\OauthServer;
use App\Service\PageMeta;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Auth\AuthenticatorInterface;
use Polidog\Relayer\Auth\SessionStorage;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * ログイン画面。メールアドレスとパスワードの 1 組だけを受ける。
 *
 * 失敗の理由（アドレス違い・パスワード違い・そもそも未設定）は区別せず
 * 同じ文言を返す。どれが原因か伝えると、正しいアドレスを総当たりで
 * 探る手掛かりになる。
 */
return function (
    PageContext $ctx,
    PageMeta $meta,
    AuthenticatorInterface $auth,
    AdminUserProvider $admin,
    SessionStorage $session,
): Closure {
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/login', 'ログイン');

    /**
     * ログイン後の行き先。
     *
     * 通常は管理画面だが、MCP コネクタの同意画面（/oauth/authorize）から
     * 送られてきた場合はそちらへ戻す。戻り先を URL で受け取らずセッションに
     * 預けたクエリだけを使うのは、任意の URL へ飛べる口を作らないため。
     */
    $destination = static function () use ($session): string {
        $pending = $session->get(OauthServer::PENDING_SESSION_KEY);

        if (!\is_array($pending) || [] === $pending) {
            return '/admin';
        }

        $session->remove(OauthServer::PENDING_SESSION_KEY);

        return '/oauth/authorize?' . \http_build_query($pending);
    };

    // ログイン済みで開いたら管理画面へ返す（ブックマークから来たとき用）。
    if ($auth->check()) {
        $ctx->redirect($destination());
    }

    $failed = false;
    $email = '';
    $configured = $admin->configured();

    $login = $ctx->action('login', function (array $form) use ($auth, $ctx, $destination, &$failed, &$email): void {
        $email = \trim((string) ($form['email'] ?? ''));
        $password = (string) ($form['password'] ?? '');

        if ('' === $email || '' === $password || null === $auth->attempt($email, $password)) {
            $failed = true;

            return;
        }

        $ctx->redirect($destination());
    });

    return function () use ($login, $configured, &$failed, &$email): Element {
        return (
            <div className="mx-auto max-w-sm pt-16">
                <h1 className="text-[1.375rem] font-semibold tracking-tight text-ink">管理画面にログイン</h1>

                {$failed
                    ? <div className="mt-6">
                        {AdminComponents::notice('error', 'メールアドレスかパスワードが違います。')}
                    </div>
                    : null}

                {$configured
                    ? null
                    : <div className="mt-6">
                        {AdminComponents::notice('warn', 'ADMIN_EMAIL と ADMIN_PASSWORD_HASH が設定されていません。')}
                    </div>}

                <form action={$login} method="post" className="mt-8 flex flex-col gap-5">
                    <label className="block">
                        <span className={AdminComponents::LABEL}>メールアドレス</span>
                        <input
                            type="email"
                            name="email"
                            value={$email}
                            required={true}
                            autocomplete="username"
                            autofocus={true}
                            className={'mt-1.5 ' . AdminComponents::INPUT}
                        />
                    </label>
                    <label className="block">
                        <span className={AdminComponents::LABEL}>パスワード</span>
                        <input
                            type="password"
                            name="password"
                            required={true}
                            autocomplete="current-password"
                            className={'mt-1.5 ' . AdminComponents::INPUT}
                        />
                    </label>
                    <button type="submit" className={AdminComponents::BUTTON . ' mt-1 w-full py-3'}>
                        ログイン
                    </button>
                </form>
            </div>
        );
    };
};
