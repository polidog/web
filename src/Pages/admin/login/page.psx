<?php

declare(strict_types=1);

use App\Auth\AdminUserProvider;
use App\Service\PageMeta;
use App\Support\PageCache;
use Polidog\Relayer\Auth\AuthenticatorInterface;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * ログイン画面。メールアドレスとパスワードの 1 組だけを受ける。
 *
 * 失敗の理由（アドレス違い・パスワード違い・そもそも未設定）は区別せず
 * 同じ文言を返す。どれが原因か伝えると、正しいアドレスを総当たりで
 * 探る手掛かりになる。
 */
return function (
    PageContext $ctx,
    PageMeta $meta,
    AuthenticatorInterface $auth,
    AdminUserProvider $admin,
): Closure {
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/login', 'ログイン');

    // ログイン済みで開いたら管理画面へ返す（ブックマークから来たとき用）。
    if ($auth->check()) {
        $ctx->redirect('/admin');
    }

    $failed = false;
    $email = '';
    $configured = $admin->configured();

    $login = $ctx->action('login', function (array $form) use ($auth, $ctx, &$failed, &$email): void {
        $email = \trim((string) ($form['email'] ?? ''));
        $password = (string) ($form['password'] ?? '');

        if ('' === $email || '' === $password || null === $auth->attempt($email, $password)) {
            $failed = true;

            return;
        }

        $ctx->redirect('/admin');
    });

    return function () use ($login, $configured, &$failed, &$email): Element {
        $inputClass = 'mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm '
            . 'focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500 '
            . 'dark:border-gray-600 dark:bg-slate-700 dark:text-white';
        $labelClass = 'block text-sm font-medium text-gray-700 dark:text-gray-300';

        return (
            <div className="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-slate-800">
                <h1 className="text-xl font-bold text-gray-900 dark:text-white">管理画面にログイン</h1>

                {$failed
                    ? <p className="mt-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">
                        メールアドレスかパスワードが違います。
                    </p>
                    : null}

                {$configured
                    ? null
                    : <p className="mt-4 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
                        ADMIN_EMAIL と ADMIN_PASSWORD_HASH が設定されていません。
                    </p>}

                <form action={$login} method="post" className="mt-6 space-y-5">
                    <label className="block">
                        <span className={$labelClass}>メールアドレス</span>
                        <input
                            type="email"
                            name="email"
                            value={$email}
                            required={true}
                            autocomplete="username"
                            autofocus={true}
                            className={$inputClass}
                        />
                    </label>
                    <label className="block">
                        <span className={$labelClass}>パスワード</span>
                        <input
                            type="password"
                            name="password"
                            required={true}
                            autocomplete="current-password"
                            className={$inputClass}
                        />
                    </label>
                    <button
                        type="submit"
                        className="w-full rounded-md bg-gray-900 px-4 py-3 text-sm font-semibold text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
                    >ログイン</button>
                </form>
            </div>
        );
    };
};
