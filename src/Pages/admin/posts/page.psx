<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Service\PostWriter;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 記事の一覧。下書きも含め、状態と語句で絞り込める。
 * 1301 件あるので検索が無いと使い物にならない。
 *
 * 行のチェックボックスで選んだぶんをまとめて公開できる。対象は「選んだ
 * 記事」だけで、絞り込みに一致する全件ではない —— 条件を 1 つ間違えた
 * だけで数百件が公開されるのは、取り返しがつかないわりに得が少ない。
 */
return function (
    PageContext $ctx,
    PostRepository $posts,
    PostWriter $writer,
    PageMeta $meta,
    Request $request,
): Closure {
    $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/posts', '記事');

    $page = \max(1, (int) ($request->query('page') ?? '1'));
    $status = $request->query('status') ?? '';
    $query = $request->query('q') ?? '';

    // 一括公開は POST で来る。form action はページのパスだけでクエリを
    // 保持しないので、絞り込みは hidden で持ち回って戻り先を組み直す。
    $publish = $ctx->action('publish', function (array $form) use ($writer, $ctx): void {
        $ids = \array_values(\array_filter(\array_map(
            static fn (mixed $id): int => (int) (\is_scalar($id) ? $id : 0),
            \is_array($form['ids'] ?? null) ? $form['ids'] : [],
        )));

        $count = [] !== $ids ? $writer->setStatusMany($ids, 'published') : 0;

        $back = \array_filter([
            'page' => (string) ($form['page'] ?? ''),
            'status' => (string) ($form['status'] ?? ''),
            'q' => (string) ($form['q'] ?? ''),
            'published' => (string) $count,
        ]);

        $ctx->redirect('/admin/posts?' . \http_build_query($back));
    });

    $published = (int) ($request->query('published') ?? '0');

    return function () use ($posts, $page, $status, $query, $publish, $published): Element {
        $list = $posts->listForAdmin('post', $page, '' !== $status ? $status : null, $query);

        return (
            <div>
                {AdminComponents::pageHeader(
                    '記事',
                    \sprintf('全 %d 件', $list->total),
                    [H::a(href: '/admin/posts/new', className: AdminComponents::BUTTON, children: '新しい記事')],
                )}

                {$published > 0
                    ? AdminComponents::notice('ok', \sprintf('%d 件を公開しました。キャッシュも更新済みです。', $published))
                    : H::div()}

                <form method="get" action="/admin/posts" className="mb-8 flex flex-wrap items-center gap-3">
                    <input
                        type="search"
                        name="q"
                        value={$query}
                        placeholder="タイトル・URL で検索"
                        aria-label="タイトル・URL で検索"
                        className="w-64 rounded-md border border-hairline bg-surface px-3 py-2 text-sm text-ink transition-colors placeholder:text-faint hover:border-muted"
                    />
                    <select
                        name="status"
                        aria-label="公開状態で絞り込む"
                        className="rounded-md border border-hairline bg-surface px-3 py-2 text-sm text-ink"
                    >
                        <option value="" selected={'' === $status}>すべて</option>
                        <option value="published" selected={'published' === $status}>公開</option>
                        <option value="draft" selected={'draft' === $status}>下書き</option>
                    </select>
                    <button type="submit" className={AdminComponents::BUTTON_QUIET}>絞り込む</button>
                </form>

                <form action={$publish} method="post" data-bulk="true">
                    <input type="hidden" name="page" value={(string) $page} />
                    <input type="hidden" name="status" value={$status} />
                    <input type="hidden" name="q" value={$query} />
                    {AdminComponents::postTable($list, '/admin/posts', 'ids[]')}
                    {[] !== $list->items ? AdminComponents::bulkBar('選択した記事を公開') : H::div()}
                </form>

                {AdminComponents::adminPagination(
                    $list,
                    '/admin/posts',
                    \http_build_query(\array_filter(['status' => $status, 'q' => $query])),
                )}
            </div>
        );
    };
};
