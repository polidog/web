<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostFormMapper;
use App\Service\PostRepository;
use App\Service\PostWriter;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 固定ページの編集。
 */
return function (
    PageContext $ctx,
    PostRepository $posts,
    PostWriter $writer,
    PostFormMapper $mapper,
    PageMeta $meta,
    Request $request,
): Closure {
    $user = $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());

    $id = (int) ($ctx->params['id'] ?? 0);
    $page = $posts->findById($id);
    if (null === $page || 'page' !== $page['kind']) {
        $ctx->notFound();
    }

    $meta->apply(\sprintf('/admin/pages/%d', $id), (string) $page['title']);

    $errors = [];
    $submitted = [];

    $save = $ctx->action('save', function (array $form) use ($writer, $mapper, $ctx, $user, $id, &$errors, &$submitted): void {
        $submitted = $form;
        $mapped = $mapper->map($form, 'page', (int) $user->id);

        if (null === $mapped['input']) {
            $errors = \array_values($mapped['errors']);

            return;
        }

        $writer->save($mapped['input'], $id);
        $ctx->redirect(\sprintf('/admin/pages/%d?saved=1', $id));
    });

    $delete = $ctx->action('delete', function (array $form) use ($writer, $ctx, $id): void {
        $writer->delete($id);
        $ctx->redirect('/admin/pages');
    });

    $saved = null !== $request->query('saved');

    return function () use ($page, $save, $delete, $saved, &$errors, &$submitted): Element {
        return (
            <div className="space-y-6">
                <div className="flex items-center justify-between">
                    <h1 className="text-xl font-bold text-gray-900 dark:text-white">ページを編集</h1>
                    <a
                        href="/admin/pages"
                        className="text-sm text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
                    >一覧に戻る</a>
                </div>

                {$saved
                    ? <p className="rounded-md bg-green-50 px-4 py-3 text-sm text-green-800 dark:bg-green-900/20 dark:text-green-300">
                        保存しました。
                    </p>
                    : null}

                {AdminComponents::postForm(
                    saveAction: $save,
                    post: [] !== $submitted ? $submitted + $page : $page,
                    errors: $errors,
                    withTaxonomy: false,
                    deleteAction: $delete,
                )}
            </div>
        );
    };
};
