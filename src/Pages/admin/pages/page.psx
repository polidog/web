<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostRepository;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 固定ページの一覧（`kind = "page"`）。`/about` のような 1 階層の
 * ページはここから自由に増やせる。
 */
return function (PageContext $ctx, PostRepository $posts, PageMeta $meta, Request $request): Closure {
    $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/pages', 'ページ');

    $page = \max(1, (int) ($request->query('page') ?? '1'));

    return function () use ($posts, $page): Element {
        $list = $posts->listForAdmin('page', $page);

        return (
            <div>
                {AdminComponents::pageHeader(
                    'ページ',
                    \sprintf('全 %d 件', $list->total),
                    [H::a(href: '/admin/pages/new', className: AdminComponents::BUTTON, children: '新しいページ')],
                )}
                {AdminComponents::postTable($list, '/admin/pages')}
                {AdminComponents::adminPagination($list, '/admin/pages')}
            </div>
        );
    };
};
