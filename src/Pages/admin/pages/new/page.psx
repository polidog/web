<?php

declare(strict_types=1);

use App\Service\PageMeta;
use App\Service\PostFormMapper;
use App\Service\PostWriter;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 固定ページの新規作成。タグ・カテゴリ欄は出さない（記事の分類軸に
 * 固定ページが混ざると一覧が濁るため）。
 */
return function (
    PageContext $ctx,
    PostWriter $writer,
    PostFormMapper $mapper,
    PageMeta $meta,
): Closure {
    $user = $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/pages/new', '新しいページ');

    $errors = [];
    $submitted = [];

    $save = $ctx->action('save', function (array $form) use ($writer, $mapper, $ctx, $user, &$errors, &$submitted): void {
        $submitted = $form;
        $mapped = $mapper->map($form, 'page', (int) $user->id);

        if (null === $mapped['input']) {
            $errors = \array_values($mapped['errors']);

            return;
        }

        $page = $writer->save($mapped['input']);
        $ctx->redirect(\sprintf('/admin/pages/%d?saved=1', (int) $page['id']));
    });

    return function () use ($save, &$errors, &$submitted): Element {
        return (
            <div>
                {AdminComponents::breadcrumb('/admin/pages', 'ページ', '新規')}
                {AdminComponents::editor(
                    saveAction: $save,
                    post: [] !== $submitted ? $submitted : ['path' => '/'],
                    indexHref: '/admin/pages',
                    indexLabel: 'ページ一覧',
                    errors: $errors,
                    withTaxonomy: false,
                )}
            </div>
        );
    };
};
