<?php

declare(strict_types=1);

use App\Http\UploadedFiles;
use App\Service\MediaStorage;
use App\Service\PageMeta;
use App\Support\PageCache;
use App\View\AdminComponents;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 画像のアップロードと一覧。
 *
 * 保存先は volume（本番は /data/uploads/images）で、配信は Caddy が
 * `/images/*` を直接返す。PHP を通らないぶん、画像も CDN 前提で安く済む。
 *
 * 記事に貼るときはエディタに直接ドロップするのが早い（admin.js が
 * `/admin/media/upload` に投げて `![](...)` を挿す）。この画面は
 * 「前に上げたものを探して貼る」ときのためにあるので、1 件ごとに
 * パスと Markdown をコピーするボタンを置いてある。
 */
return function (
    PageContext $ctx,
    MediaStorage $media,
    UploadedFiles $uploads,
    PageMeta $meta,
): Closure {
    $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/media', '画像');

    $errors = [];
    $uploaded = [];

    $upload = $ctx->action('upload', function (array $form) use ($media, $uploads, &$errors, &$uploaded): void {
        $files = $uploads->all('files');
        if ([] === $files) {
            $errors[] = 'ファイルが選択されていません。';

            return;
        }

        foreach ($files as $file) {
            if (\UPLOAD_ERR_OK !== $file['error']) {
                $errors[] = \sprintf('%s のアップロードに失敗しました（コード %d）。', $file['name'], $file['error']);

                continue;
            }

            try {
                $uploaded[] = $media->store($file['tmpName'], $file['name']);
            } catch (\RuntimeException $e) {
                $errors[] = \sprintf('%s: %s', $file['name'], $e->getMessage());
            }
        }
    });

    return function () use ($media, $upload, &$errors, &$uploaded): Element {
        $files = $media->recent();

        $size = static function (int $bytes): string {
            return $bytes >= 1048576
                ? \sprintf('%.1f MB', $bytes / 1048576)
                : \sprintf('%d KB', (int) \max(1, \round($bytes / 1024)));
        };

        $card = static fn (array $file): Element => (
            <div className="flex flex-col gap-2">
                <a href={$file['url']} target="_blank" rel="noopener" className="block overflow-hidden rounded-lg bg-raised">
                    <img
                        src={$file['url']}
                        alt=""
                        loading="lazy"
                        className="h-32 w-full object-cover transition-opacity hover:opacity-80"
                    />
                </a>
                <p className="truncate text-xs text-ink">{\basename($file['url'])}</p>
                <p className="font-mono text-[0.6875rem] text-faint">
                    {\sprintf('%s · %s', $size($file['size']), \date('Y.m.d', $file['modifiedAt']))}
                </p>
                <div className="-ml-2 flex items-center gap-1">
                    {AdminComponents::copyButton($file['url'], 'パス')}
                    {AdminComponents::copyButton(\sprintf('![](%s)', $file['url']), 'Markdown')}
                </div>
            </div>
        );

        return (
            <div>
                {AdminComponents::pageHeader('画像', \sprintf('直近 %d 件', \count($files)))}

                <form
                    action={$upload}
                    method="post"
                    enctype="multipart/form-data"
                    className="mb-10 flex flex-wrap items-center gap-4 rounded-lg bg-raised p-5"
                >
                    <input
                        type="file"
                        name="files[]"
                        multiple={true}
                        accept="image/*"
                        aria-label="アップロードする画像"
                        className="min-w-0 flex-1 text-sm text-muted"
                    />
                    <button type="submit" className={AdminComponents::BUTTON}>アップロード</button>
                </form>

                {[] !== $errors ? AdminComponents::notice('error', $errors) : null}

                {[] !== $uploaded
                    ? AdminComponents::notice(
                        'ok',
                        \array_map(
                            static fn (string $url): string => \sprintf('アップロードしました: %s', $url),
                            $uploaded,
                        ),
                    )
                    : null}

                {[] === $files
                    ? AdminComponents::emptyState('まだ画像がありません。')
                    : <div className="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
                        {\array_map($card, $files)}
                    </div>}
            </div>
        );
    };
};
