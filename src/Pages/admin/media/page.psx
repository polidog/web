<?php

declare(strict_types=1);

use App\Http\UploadedFiles;
use App\Service\MediaStorage;
use App\Service\PageMeta;
use App\Support\PageCache;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 画像のアップロードと一覧。
 *
 * 保存先は volume（本番は /data/uploads/images）で、配信は Caddy が
 * `/images/*` を直接返す。PHP を通らないぶん、画像も CDN 前提で安く済む。
 */
return function (
    PageContext $ctx,
    MediaStorage $media,
    UploadedFiles $uploads,
    PageMeta $meta,
): Closure {
    $ctx->requireAuth(['admin'], '/admin/login');
    $ctx->cache(PageCache::admin());
    $meta->apply('/admin/media', '画像');

    $errors = [];
    $uploaded = [];

    $upload = $ctx->action('upload', function (array $form) use ($media, $uploads, &$errors, &$uploaded): void {
        $files = $uploads->all('files');
        if ([] === $files) {
            $errors[] = 'ファイルが選択されていません。';

            return;
        }

        foreach ($files as $file) {
            if (\UPLOAD_ERR_OK !== $file['error']) {
                $errors[] = \sprintf('%s のアップロードに失敗しました（コード %d）。', $file['name'], $file['error']);

                continue;
            }

            try {
                $uploaded[] = $media->store($file['tmpName'], $file['name']);
            } catch (\RuntimeException $e) {
                $errors[] = \sprintf('%s: %s', $file['name'], $e->getMessage());
            }
        }
    });

    return function () use ($media, $upload, &$errors, &$uploaded): Element {
        $files = $media->recent();

        return (
            <div className="space-y-8">
                <h1 className="text-xl font-bold text-gray-900 dark:text-white">画像</h1>

                <form
                    action={$upload}
                    method="post"
                    enctype="multipart/form-data"
                    className="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-slate-800"
                >
                    <input
                        type="file"
                        name="files[]"
                        multiple={true}
                        accept="image/*"
                        className="block w-full text-sm text-gray-700 dark:text-gray-300"
                    />
                    <button
                        type="submit"
                        className="mt-4 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-500"
                    >アップロード</button>
                </form>

                {[] !== $errors
                    ? <div className="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">
                        {\array_map(static fn (string $e): Element => H::p(children: $e), $errors)}
                    </div>
                    : null}

                {[] !== $uploaded
                    ? <div className="rounded-md bg-green-50 px-4 py-3 text-sm text-green-800 dark:bg-green-900/20 dark:text-green-300">
                        {\array_map(
                            static fn (string $url): Element => H::p(children: \sprintf('アップロードしました: %s', $url)),
                            $uploaded,
                        )}
                    </div>
                    : null}

                <div className="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
                    {\array_map(
                        static fn (array $file): Element => (
                            <a
                                href={$file['url']}
                                target="_blank"
                                rel="noopener"
                                className="group overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-slate-800"
                            >
                                <img
                                    src={$file['url']}
                                    alt=""
                                    loading="lazy"
                                    className="h-32 w-full object-cover"
                                />
                                <span className="block truncate px-3 py-2 text-xs text-gray-600 dark:text-gray-400">
                                    {$file['url']}
                                </span>
                            </a>
                        ),
                        $files,
                    )}
                </div>
            </div>
        );
    };
};
