<?php

declare(strict_types=1);

namespace App\Pages;

use Polidog\Relayer\Router\Component\ErrorPageComponent;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 404 / 403 / 500 の共通ページ。ルートレイアウトの中に描画される。
 *
 * 20 年ぶんの記事があるサイトなので、404 に飛ぶ人はたいてい古いリンクを
 * 踏んでいる。行き止まりにせず、タグ一覧とアーカイブへ誘導する。
 */
final class ErrorPage extends ErrorPageComponent
{
    public function render(): Element
    {
        $status = $this->getStatusCode();

        return (
            <div className="mx-auto max-w-2xl py-16 text-center">
                <p className="text-base font-semibold text-sky-600 dark:text-sky-400">{(string) $status}</p>
                <h1 className="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
                    {$this->headline($status)}
                </h1>
                <p className="mt-6 text-base text-gray-600 dark:text-gray-400">
                    {$this->description($status)}
                </p>
                <div className="mt-10 flex items-center justify-center gap-4">
                    <a
                        href="/"
                        className="rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-500"
                    >トップへ</a>
                    <a
                        href="/archives"
                        className="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
                    >アーカイブを見る</a>
                </div>
            </div>
        );
    }

    private function headline(int $status): string
    {
        return match ($status) {
            404 => 'ページが見つかりません',
            403 => 'アクセスできません',
            default => 'エラーが発生しました',
        };
    }

    private function description(int $status): string
    {
        return match ($status) {
            404 => 'URL が変わったか、記事が下書きに戻された可能性があります。',
            403 => 'このページを見る権限がありません。',
            default => $this->getMessage(),
        };
    }
}
