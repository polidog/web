<?php

declare(strict_types=1);

namespace App\Pages;

use Polidog\Relayer\Router\Component\ErrorPageComponent;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

/**
 * 404 / 403 / 500 の共通ページ。ルートレイアウトの中に描画される。
 *
 * 20 年ぶんの記事があるサイトなので、404 に飛ぶ人はたいてい古いリンクを
 * 踏んでいる。行き止まりにせず、タグ一覧とアーカイブへ誘導する。
 *
 * ステータス番号は一覧の年号マーカーと同じ組み方（大きく淡い等幅）にして
 * ある。中央揃えにしないのも一覧と揃えるため。
 */
final class ErrorPage extends ErrorPageComponent
{
    public function render(): Element
    {
        $status = $this->getStatusCode();

        return (
            <div className="py-16">
                <p className="font-mono text-5xl font-light leading-none tracking-tight text-faint">
                    {(string) $status}
                </p>
                <h1 className="mt-8 text-[1.75rem] font-semibold leading-tight tracking-tight text-ink sm:text-[2rem]">
                    {$this->headline($status)}
                </h1>
                <p className="mt-5 text-[0.9375rem] leading-relaxed text-muted">
                    {$this->description($status)}
                </p>
                <div className="mt-12 flex flex-wrap gap-x-8 gap-y-3">
                    <a
                        href="/"
                        className="text-[0.8125rem] text-muted transition-colors hover:text-accent"
                    >トップへ →</a>
                    <a
                        href="/archives"
                        className="text-[0.8125rem] text-muted transition-colors hover:text-accent"
                    >アーカイブを見る →</a>
                    <a
                        href="/tech-tags"
                        className="text-[0.8125rem] text-muted transition-colors hover:text-accent"
                    >タグから探す →</a>
                </div>
            </div>
        );
    }

    private function headline(int $status): string
    {
        return match ($status) {
            404 => 'ページが見つかりません',
            403 => 'アクセスできません',
            default => 'エラーが発生しました',
        };
    }

    private function description(int $status): string
    {
        return match ($status) {
            404 => 'URL が変わったか、記事が下書きに戻された可能性があります。',
            403 => 'このページを見る権限がありません。',
            default => $this->getMessage(),
        };
    }
}
