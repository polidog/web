// Tehilim schema — see https://github.com/polidog/tehilim
//
// url は「このファイルのあるディレクトリ」からの相対で解決される
// (Cli/Command/Options::resolveSqliteUrl)。tehilim は env 展開をせず
// migrate に --url も無いので、本番では Dockerfile が
// /app/var/cms.db -> /data/cms.db のシンボリックリンクを張り、この
// 相対パスのまま volume 上の DB を指すようにしている。
// アプリのランタイム側はこの値を読まず、config/services.yaml が
// DATABASE_PATH から PDO を組み立てる（両者は同じファイルを指す）。

datasource db {
  provider = "sqlite"
  url      = "sqlite:../var/cms.db"
}

generator client {
  output    = "../src/Tehilim"
  namespace = "App\\Tehilim"
}

// 管理者。ログインするのは 1 人だけで、資格情報（メールアドレスと
// パスワードハッシュ）は環境変数が持つ —— この行はパスワードを保管する
// ためではなく、記事の authorId が指す先を作るために存在する。
// 初回ログイン時に AdminUserProvider が email で upsert する。
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  posts     Post[]
}

// ブログ記事と自由ページを 1 テーブルで扱う。両者の違いは kind だけで、
// URL は常に path が持つ — Hugo 時代の URL をそのまま値として保存できる。
model Post {
  id          Int        @id @default(autoincrement())
  kind        String     @default("post")
  path        String     @unique
  title       String
  body        String
  html        String
  excerpt     String?
  eyecatch    String?
  // Hugo が Disqus に渡していた識別子（`.File.UniqueID` = content からの
  // 相対パスの md5）。これを引き継がないと既存コメントが記事から外れる。
  disqusId    String?
  status      String     @default("draft")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  authorId    Int?
  author      User?      @relation(fields: [authorId], references: [id])
  tags        Tag[]
  categories  Category[]
}

// 一意なのは slug だけ。name には unique を付けない — `JavaScript` と
// `javascript` のような表記ゆれが 20 年ぶんの記事に混ざっており、
// Hugo はそれらを同じ URL（同じ term ページ）に集約していた。
// name を一意にすると、同じ slug の別表記が入ってきた時点で衝突する。
model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  posts Post[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  posts Post[]
}

// --- MCP コネクタ用の OAuth 2.1 認可サーバー -------------------------------
//
// Claude Chat のカスタムコネクタは、繋ぎ先の MCP サーバーが OAuth 2.1 の
// 認可サーバーであることを前提にしている。ここはその保管場所。
//
// 記事側の「読みは生 SQL、書きは tehilim」という住み分けを OAuth には
// 持ち込まない。あの住み分けは PostRepository がリレーションフィルタ・
// 集約・式による ORDER BY という tehilim で書けない 3 つに当たったからで、
// OAuth のクエリは全部「一意キーで 1 件引く」か「1 件入れる/消す」しかなく、
// その制約に 1 つも触れないため。

// Claude が Dynamic Client Registration (RFC 7591) で登録してくるクライアント。
// 無認証で登録できる仕様なので、OauthStore が件数の上限を持って古い順に捨てる。
model OauthClient {
  id                      Int      @id @default(autoincrement())
  clientId                String   @unique
  clientName              String
  // redirect_uri は複数ありうるが tehilim にスカラー配列型が無いので JSON 文字列。
  redirectUris            String
  tokenEndpointAuthMethod String   @default("none")
  clientSecretHash        String?
  createdAt               DateTime @default(now())
}

// 認可コード。寿命 60 秒・1 回限りで、引き換えたら usedAt が入る。
// 平文ではなく SHA-256 を保存する（DB ファイルは記事と同じ volume に載る）。
model OauthAuthCode {
  id            Int       @id @default(autoincrement())
  codeHash      String    @unique
  clientId      String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// アクセストークンとリフレッシュトークンを 1 行のペアで持つ。
// 公開クライアントにはリフレッシュのローテーションが必須で、
// ペアで持てば「古い行を失効させて新しい行を作る」の 1 操作で済む。
// こちらも保存するのは SHA-256 だけ。
model OauthToken {
  id               Int       @id @default(autoincrement())
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  clientId         String
  scope            String
  // トークンの audience。RFC 8707 の resource パラメータで、MCP は
  // 「自分宛てに発行されたトークンであることの検証」を MUST にしている。
  resource         String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
}
