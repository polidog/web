// Tehilim schema — see https://github.com/polidog/tehilim
//
// url は「このファイルのあるディレクトリ」からの相対で解決される
// (Cli/Command/Options::resolveSqliteUrl)。tehilim は env 展開をせず
// migrate に --url も無いので、本番では Dockerfile が
// /app/var/cms.db -> /data/cms.db のシンボリックリンクを張り、この
// 相対パスのまま volume 上の DB を指すようにしている。
// アプリのランタイム側はこの値を読まず、config/services.yaml が
// DATABASE_PATH から PDO を組み立てる（両者は同じファイルを指す）。

datasource db {
  provider = "sqlite"
  url      = "sqlite:../var/cms.db"
}

generator client {
  output    = "../src/Tehilim"
  namespace = "App\\Tehilim"
}

// 管理者。GitHub OAuth でログインした人だけがここに入る。
model User {
  id        Int      @id @default(autoincrement())
  githubId  Int      @unique
  login     String
  name      String?
  avatarUrl String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  posts     Post[]
}

// ブログ記事と自由ページを 1 テーブルで扱う。両者の違いは kind だけで、
// URL は常に path が持つ — Hugo 時代の URL をそのまま値として保存できる。
model Post {
  id          Int        @id @default(autoincrement())
  kind        String     @default("post")
  path        String     @unique
  title       String
  body        String
  html        String
  excerpt     String?
  eyecatch    String?
  // Hugo が Disqus に渡していた識別子（`.File.UniqueID` = content からの
  // 相対パスの md5）。これを引き継がないと既存コメントが記事から外れる。
  disqusId    String?
  status      String     @default("draft")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  authorId    Int?
  author      User?      @relation(fields: [authorId], references: [id])
  tags        Tag[]
  categories  Category[]
}

// 一意なのは slug だけ。name には unique を付けない — `JavaScript` と
// `javascript` のような表記ゆれが 20 年ぶんの記事に混ざっており、
// Hugo はそれらを同じ URL（同じ term ページ）に集約していた。
// name を一意にすると、同じ slug の別表記が入ってきた時点で衝突する。
model Tag {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  posts Post[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  posts Post[]
}
