# Relayer reads APP_ENV: `dev` enables on-the-fly PSX compilation,
# request profiling and traceable decorators. Unset (or any other
# value) is treated as production.
APP_ENV=dev

# SQLite。未設定なら var/cms.db。fly.io では volume 上の /data/cms.db を
# 指す（Dockerfile が var/cms.db -> /data/cms.db のシンボリックリンクを
# 張るので、tehilim CLI も同じファイルを見る）。
# DATABASE_PATH=/data/cms.db

# 画像の置き場。未設定なら var/uploads。Caddy が /images/* を直接配信する。
# UPLOADS_DIR=/data/uploads

# canonical / RSS / OGP の絶対 URL に使う。
SITE_URL=http://127.0.0.1:8000

# 管理画面のログイン。ここには書かない —— このファイルはコミットされる。
# ローカルは .gitignore 済みの .env.local に、fly は `fly secrets set` に置く。
# ハッシュは `php bin/hash-password.php` で作り、`$` が変数展開に食われない
# ようシングルクォートで囲んだまま貼ること。
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_HASH='$2y$12$...'

# Cloudflare のキャッシュ purge。未設定なら purge は no-op になり、
# ETag による 304 短絡だけが効く（ローカル開発はこれでよい）。
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Disqus。空にするとコメント欄を出力しない。
DISQUS_SHORTNAME=polidoglab

# Set USEPHP_SNAPSHOT_SECRET in production if any page serializes
# snapshot state (a long random string).
